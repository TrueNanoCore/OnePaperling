    "quickInput.background": "#151515",
    "quickInput.foreground": "#D4D4D4",
    "quickInputList.focusBackground": "#3ECF8E33",
    "quickInputList.focusForeground": "#FFFFFF",
    "peekView.border": "#3ECF8E",
    "peekViewEditor.background": "#1A1A1A",
    "peekViewEditor.matchHighlightBackground": "#3ECF8E33",
    "peekViewResult.background": "#151515",
    "peekViewResult.matchHighlightBackground": "#3ECF8E33",
    "peekViewTitle.background": "#151515",
    "peekViewTitleLabel.foreground": "#FFFFFF",
    "peekViewTitleDescription.foreground": "#AAAAAA",
