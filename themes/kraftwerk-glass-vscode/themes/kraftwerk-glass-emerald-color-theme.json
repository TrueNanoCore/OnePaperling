    "symbolIcon.colorForeground": "#BB9AF7",
    "symbolIcon.constantForeground": "#BB9AF7",
    "symbolIcon.constructorForeground": "#7AA2F7",
    "symbolIcon.enumeratorForeground": "#FF9E64",
    "symbolIcon.functionForeground": "#7DCFFF",
    "symbolIcon.interfaceForeground": "#2AC3DE",
    "symbolIcon.keyForeground": "#73DACA",
    "symbolIcon.keywordForeground": "#9D7CD8",
    "symbolIcon.methodForeground": "#7DCFFF",
    "symbolIcon.moduleForeground": "#7AA2F7",
    "symbolIcon.namespaceForeground": "#7AA2F7",
    "symbolIcon.numberForeground": "#FF9E64",
    "symbolIcon.objectForeground": "#73DACA",
    "symbolIcon.operatorForeground": "#89DDFF",
    "symbolIcon.propertyForeground": "#73DACA",
    "symbolIcon.stringForeground": "#9ECE6A",
    "symbolIcon.structForeground": "#2AC3DE",
    "symbolIcon.variableForeground": "#C0CAF5"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#565F89",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FF9E64"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9D7CD8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#A9B1D6"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function.builtin",
        "support.function.construct"
      ],
      "settings": {
        "foreground": "#9D7CD8"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2AC3DE"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "entity.name.function.constructor",
        "meta.constructor"
      ],
      "settings": {
        "foreground": "#7AA2F7"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Special variables",
      "scope": [
        "variable.language",
        "variable.other.readwrite.instance",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "Properties and JSON keys",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "string.unquoted.property",
        "source.json meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#0DB9D7"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7DCFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C0CAF5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C0CAF5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3ECF8E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E0AF68"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F7768E"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.readonly": "#BB9AF7",
    "variable.defaultLibrary": "#F7768E",
    "parameter": "#C0CAF5",
    "property": "#73DACA",
    "enumMember": "#FF9E64",
    "function": "#7DCFFF",
    "method": "#7DCFFF",
    "class": "#2AC3DE",
    "interface": "#2AC3DE",
    "type": "#2AC3DE",
    "namespace": "#7AA2F7",
    "keyword": "#9D7CD8",
    "stringLiteral": "#9ECE6A",
    "numberLiteral": "#FF9E64",
    "comment": {
      "foreground": "#565F89",
      "italic": true
    }
  }
}